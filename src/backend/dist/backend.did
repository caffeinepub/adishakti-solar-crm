type UserRole__1 = 
 variant {
   admin;
   guest;
   user;
 };
type UserRole = 
 variant {
   admin;
   backoffice;
   operation;
   sales;
 };
type UserProfile = 
 record {
   district: text;
   email: text;
   isActive: bool;
   name: text;
   passwordHash: text;
   phone: text;
   role: UserRole;
   userId: text;
   whatsAppNumber: text;
 };
type Time = int;
type Requirement = 
 record {
   estimatedValue: nat;
   notes: text;
   panelSize: text;
   systemType: text;
 };
type Remark = 
 record {
   addedAt: Time;
   addedBy: text;
   content: text;
 };
type PipelineStage = 
 variant {
   bookingConfirmed;
   closedLost;
   closedWon;
   inquiry;
   installation;
   surveyScheduled;
 };
type Lead = 
 record {
   address: text;
   assignedOperationsPerson: opt text;
   assignedSalesPerson: opt text;
   createdAt: Time;
   createdBy: text;
   customerName: text;
   district: text;
   email: text;
   id: nat;
   notes: text;
   phone: text;
   remarks: vec Remark;
   requirements: Requirement;
   stage: PipelineStage;
   updatedAt: Time;
 };
service : {
  _initializeAccessControl: () -> ();
  addDistrict: (sessionToken: text, name: text) -> (variant {
                                                      err: text;
                                                      ok;
                                                    });
  addLead: (sessionToken: text, customerName: text, phone: text, email: 
   text, address: text, district: text, requirements: Requirement, notes:
   text) -> (variant {
               err: text;
               ok: Lead;
             });
  addRemark: (sessionToken: text, leadId: nat, content: text) ->
   (variant {
      err: text;
      ok: Lead;
    });
  assignCallerUserRole: (user: principal, role: UserRole__1) -> ();
  assignLeadToOperations: (sessionToken: text, leadId: nat, operationsUserId:
   text) -> (variant {
               err: text;
               ok: Lead;
             });
  assignLeadToSales: (sessionToken: text, leadId: nat, salesUserId: text) ->
   (variant {
      err: text;
      ok: Lead;
    });
  changePassword: (sessionToken: text, userId: text, newPassword: text) ->
   (variant {
      err: text;
      ok;
    });
  createUser: (sessionToken: text, userId: text, password: text, name: 
   text, role: UserRole, district: text, phone: text, email: text,
   whatsAppNumber: text) -> (variant {
                               err: text;
                               ok;
                             });
  getAllDistricts: () -> (vec text) query;
  getAllLeads: (sessionToken: text) ->
   (variant {
      err: text;
      ok: vec Lead;
    }) query;
  getAllUsers: (sessionToken: text) ->
   (variant {
      err: text;
      ok: vec UserProfile;
    }) query;
  getCallerUserRole: () -> (UserRole__1) query;
  getLeadById: (sessionToken: text, leadId: nat) ->
   (variant {
      err: text;
      ok: Lead;
    }) query;
  getLeadsAddedToday: (sessionToken: text) ->
   (variant {
      err: text;
      ok: nat;
    }) query;
  getLeadsByDistrict: (sessionToken: text, district: text) ->
   (variant {
      err: text;
      ok: vec Lead;
    }) query;
  getLeadsByDistrictCount: (sessionToken: text) ->
   (variant {
      err: text;
      ok: vec record {
                text;
                nat;
              };
    }) query;
  getLeadsByStage: (sessionToken: text, stage: PipelineStage) ->
   (variant {
      err: text;
      ok: vec Lead;
    }) query;
  getLeadsByStageCount: (sessionToken: text) ->
   (variant {
      err: text;
      ok: vec record {
                PipelineStage;
                nat;
              };
    }) query;
  getMyLeads: (sessionToken: text) ->
   (variant {
      err: text;
      ok: vec Lead;
    }) query;
  getMyProfile: (sessionToken: text) ->
   (variant {
      err: text;
      ok: UserProfile;
    }) query;
  getTotalLeadsCount: (sessionToken: text) ->
   (variant {
      err: text;
      ok: nat;
    }) query;
  getUserById: (sessionToken: text, userId: text) ->
   (variant {
      err: text;
      ok: UserProfile;
    }) query;
  isCallerAdmin: () -> (bool) query;
  login: (username: text, password: text) -> (variant {
                                                err: text;
                                                ok: text;
                                              });
  logout: (sessionToken: text) -> ();
  updateLead: (sessionToken: text, leadId: nat, customerName: text, phone:
   text, email: text, address: text, district: text, requirements:
   Requirement, notes: text) -> (variant {
                                   err: text;
                                   ok: Lead;
                                 });
  updateLeadStage: (sessionToken: text, leadId: nat, stage: PipelineStage,
   notes: text) -> (variant {
                      err: text;
                      ok: Lead;
                    });
  updateUser: (sessionToken: text, userId: text, name: text, district: 
   text, phone: text, email: text, whatsAppNumber: text, isActive: bool) ->
   (variant {
      err: text;
      ok;
    });
  validateSession: (sessionToken: text) -> (opt text) query;
}
